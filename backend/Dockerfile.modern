# Dockerfile.modern
# Modern ML environment: sklearn 1.4.2 (DASS Multiclass Anxiety)

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
  && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for the modern ML environment
COPY docker/modern/requirements-modern.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Auth0 token validation needs PyJWT. Kept in its own layer so adding it
# does not invalidate the expensive ML dependency install above.
RUN pip install --no-cache-dir --timeout 120 --retries 10 PyJWT==2.8.0

# Copy the Django app code
COPY . /app

EXPOSE 8000

CMD ["sh", "-c", "python manage.py runserver 0.0.0.0:${PORT:-8000}"]
