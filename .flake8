[flake8]
ignore =
    E133, # closing bracket is missing indentation
    W503, # line break before binary operator
    E800, # code comments
    E731, # lambda expressions
    C408, # dict() calls
extend-ignore =
    E203, # colons should not have any space before them, not black-compatible
exclude =
    __init__.py,docs/conf.py, test_pi.py
max-line-length = 100
enable-extensions =
    G # Logging violations such as fstrings, exceptions, etc. (default is version dependent)
