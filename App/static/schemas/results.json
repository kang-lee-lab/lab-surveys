{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Survey Results Schema",
    "description": "Survey Results Response Schema",
    "type": "object",
    "properties": {
        "survey_id": {
            "type": "string",
            "description": "Unique Survey ID"
        },
        "language": {
            "type": "string",
            "description": "Language of the survey",
            "enum": ["EN", "CH", "FR"]
        },
        "results": {
            "type": "array",
            "description": "List of result fields and values. Can be an empty list if no survey results are to be returned.",
            "items": {
                "type": "object",
                "properties": {
                    "result_id": {
                        "type": "string",
                        "description": "Result ID"
                    },
                    "result_name": {
                        "type": "string",
                        "description": "Result name"
                    },
                    "result_text": {
                        "type": "string",
                        "description": "Text description of the result"
                    },
                    "result": {
                        "type": "object",
                        "description": "Contents of the result",
                        "oneOf": [
                            {
                                "type": "object",
                                "description": "Scalar result",
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "value": "scalar"
                                    },
                                    "value": {
                                        "type": "number",
                                        "description": "Result value as a number"
                                    },
                                    "unit": {
                                        "type": "string",
                                        "description": "Result unit"
                                    },
                                    "result_explanation": {
                                        "type": "string",
                                        "description": "Result explanation in text"
                                    },
                                    "value_range_min": {
                                        "type": "number",
                                        "description": "Lower bound of the value (95% CI)"
                                    },
                                    "value_range_max": {
                                        "type": "number",
                                        "description": "Upper bound of the value (95% CI)"
                                    },
                                    "value_lower_bound": {
                                        "type": "number",
                                        "description": "Lower bound of the value"
                                    },
                                    "value_upper_bound": {
                                        "type": "number",
                                        "description": "Upper bound of the value"
                                    },
                                    "is_reverse_order": {
                                        "type": "boolean",
                                        "description": "Whether the value is reversed with severity, i.e. 0 is the best, 100 is the worst. Normal order is where 0 is the worst, 100 is the best."
                                    },
                                    "use_dial": {
                                        "type": "boolean",
                                        "description": "Whether or not to display results on a dial"
                                    }
                                },
                                "required": [
                                    "type",
                                    "value",
                                    "unit",
                                    "value_lower_bound",
                                    "value_upper_bound",
                                    "is_reverse_order",
                                    "use_dial"
                                ],
                                "additionalProperties": false
                            },
                            { 
                                "type": "object", 
                                "description": "Percentage result",
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "value": "percentage"
                                    },
                                    "value": {
                                        "type": "number",
                                        "description": "Result value as a number"
                                    },
                                    "result_explanation": {
                                        "type": "string",
                                        "description": "Result explanation in text"
                                    },
                                    "value_range_min": {
                                        "type": "number",
                                        "description": "Lower bound of the value (95% CI)"
                                    },
                                    "value_range_max": {
                                        "type": "number",
                                        "description": "Upper bound of the value (95% CI)"
                                    },
                                    "is_reverse_order": {
                                        "type": "boolean",
                                        "description": "Whether the value is reversed with severity, i.e. 0 is the best, 100 is the worst. Normal order is where 0 is the worst, 100 is the best."
                                    },
                                    "use_dial": {
                                        "type": "boolean",
                                        "description": "Whether or not to display results on a dial"
                                    }
                                },
                                "required": [
                                    "type",
                                    "value",
                                    "is_reverse_order",
                                    "use_dial"
                                ],
                                "additionalProperties": false
                            },
                            { 
                                "type": "object", 
                                "description": "Text result",
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "value": "text"
                                    },
                                    "value": {
                                        "type": "string",
                                        "description": "Result text"
                                    }
                                },
                                "required": [
                                    "type",
                                    "value"
                                ],
                                "additionalProperties": false
                            }
                        ]
                    }
                },
                "required": [
                    "result_id",
                    "result_name",
                    "result_text",
                    "result"
                ],
                "additionalProperties": false
            }
        },
        "use_multiedged_graph": {
            "type": "boolean",
            "description": "Whether or not to display results on a multiedged graph"
        },
        "use_table": {
            "type": "boolean",
            "description": "Whether or not to display results in a table"
        },
        "final_message": {
            "type": "string",
            "description": "Final message after the result (can be HTML formatted)"
        }
    },
    "required": [
        "survey_id",
        "language",
        "results",
        "use_multiedged_graph",
        "use_table",
        "final_message"
    ],
    "additionalProperties": false
}
